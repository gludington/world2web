---
import type { GetStaticPathsOptions, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import { getSiteConfig } from "../../../../lib/config";
import { getPublishedPosts } from "../../../../lib/posts";
import { postRoute, journalRoute, formatDate } from "../../../../lib/routes";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import ContentPanel from "../../../../components/ContentPanel.astro";
import Pagination from "../../../../components/Pagination.astro";

const siteName = getSiteConfig().siteName;

// Every post by a given author identity, across every journal (journal entry)
// published under that display name -- grouped by authorSlug, which is
// deliberately shared (not disambiguated) across journals with the same
// author name, unlike journalSlug. See routes.ts and render.js's assignSlugs.
// The single-journal archive lives at pages/[world]/[section]/[...journal].astro.
interface AuthorInfo {
  world: string;
  authorSlug: string;
  name: string;
  image: string | null;
  bio: string;
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const PAGE_SIZE = 10;
  const posts = await getPublishedPosts();

  const groups = new Map<
    string,
    { author: AuthorInfo; posts: CollectionEntry<"posts">[] }
  >();
  for (const post of posts) {
    const key = `${post.data.world}/${post.data.authorSlug}`;
    if (!groups.has(key)) {
      groups.set(key, {
        // Taken from whichever post is encountered first for this author,
        // same as name/image already were -- if the underlying Actor's
        // bio changed between posts, this shows whatever the first-seen
        // post happened to capture, not necessarily the latest.
        author: {
          world: post.data.world,
          authorSlug: post.data.authorSlug,
          name: post.data.author.name,
          image: post.data.author.image,
          bio: post.data.author.bio,
        },
        posts: [],
      });
    }
    groups.get(key)!.posts.push(post);
  }

  return Array.from(groups.values()).flatMap(
    ({ author, posts: authorPosts }) => {
      const sorted = authorPosts.sort(
        (a, b) => b.data.publishedAt - a.data.publishedAt,
      );
      return paginate(sorted, {
        params: { world: author.world, author: author.authorSlug },
        props: { author },
        pageSize: PAGE_SIZE,
      });
    },
  );
}

const { author } = Astro.props as { author: AuthorInfo };
const { page } = Astro.props as { page: Page<CollectionEntry<"posts">> };

// Same {title, href, subLabels, dateLabel} shape ContentPanel already
// renders for the tag archive page, so both archive kinds look and behave
// identically.
const authorItems = page.data.map((post) => ({
  title: post.data.title,
  href: postRoute(post.data),
  subLabels: [post.data.journalTitle],
  dateLabel: formatDate(post.data.publishedAt),
  frontImage: post.data.frontImage,
}));
---

<Layout title={author.name} searchable={!!author.bio}>
  <Breadcrumbs siteName={siteName} crumbs={[]} currentLabel={author.name} />

  {author.image && <img class="avatar avatar-lg" src={author.image} alt="" />}
  <h1>{author.name} <span class="header-count">({page.total})</span></h1>

  {author.bio ? (
    <div class="world-dashboard">
      <div class="main-column">
        <ContentPanel title="" items={authorItems} />
        {
          page.lastPage > 1 && (
            <Pagination
              prevUrl={page.url.prev ?? null}
              nextUrl={page.url.next ?? null}
              pageNum={page.currentPage}
              totalPages={page.lastPage}
            />
          )
        }
      </div>
      <!-- Pagefind indexing scope for this author's bio -- see
           README.md's "Search" section. Only the bio itself is
           genuinely unique prose worth indexing (the post list is just
           links already indexed on their own pages); title/image meta
           are duplicated here as hidden markers, since they live outside
           this element in the visible header above and Pagefind only
           picks up meta/filter attributes within its indexed scope. -->
      <div class="sidebar-column" data-pagefind-body>
        <span hidden data-pagefind-meta="title">{author.name}</span>
        {author.image && <img hidden src={author.image} alt="" data-pagefind-meta="image" />}
        <section class="prose author-bio" set:html={author.bio} />
      </div>
    </div>
  ) : (
    <>
      <ContentPanel title="" items={authorItems} />
      {
        page.lastPage > 1 && (
          <Pagination
            prevUrl={page.url.prev ?? null}
            nextUrl={page.url.next ?? null}
            pageNum={page.currentPage}
            totalPages={page.lastPage}
          />
        )
      }
    </>
  )}
</Layout>

<style>
  h1 {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .header-count {
    font-family: var(--color-font-body);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .avatar-lg {
    width: 64px;
    height: 64px;
    margin-bottom: 1rem;
  }

  .author-bio {
    margin-bottom: 2.5rem;
  }

  /* Structural selector to mask double borders directly below the main page title */
  :global(h1 + .panel > .panel-title) {
    display: none;
  }
</style>
