---
import type { CollectionEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { getSiteConfig } from "../../../lib/config";
import { getPublishedPosts } from "../../../lib/posts";
import {
  postRoute,
  authorRoute,
  journalRoute,
  rootCrumbs,
  sectionRoute,
  type Crumb,
  formatDate,
} from "../../../lib/routes";
import {
  toJournalInfos,
  buildSectionTree,
  journalsInSubtree,
  sortPostsForJournal,
  type JournalInfo,
  type SectionInfo,
  type JournalWithSubPath,
} from "../../../lib/sections";
import ContentPanel from "../../../components/ContentPanel.astro"; // Swapped sub-components out for ContentPanel
import Pagination from "../../../components/Pagination.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";

type PageProps =
  | { kind: "journal"; journal: JournalInfo; pagePosts: CollectionEntry<"posts">[]; pageNum: number; totalPages: number }
  | { kind: "section"; label: string; ancestorCrumbs: Crumb[]; childSections: SectionInfo[]; journalEntries: JournalWithSubPath[]; };

export async function getStaticPaths() {
  const PAGE_SIZE = 10;
  const { journalsSegment } = getSiteConfig();
  const posts = await getPublishedPosts();
  const journals = toJournalInfos(posts);
  const journalByUuid = new Map(journals.map((b) => [b.journalUuid, b] as const));
  const postsByJournalUuid = new Map<string, CollectionEntry<"posts">[]>();
  
  for (const post of posts) {
    if (!postsByJournalUuid.has(post.data.journalUuid)) postsByJournalUuid.set(post.data.journalUuid, []);
    postsByJournalUuid.get(post.data.journalUuid)!.push(post);
  }

  const journalSlugs = new Set(journals.map((b) => b.journalSlug));
  const sectionsByWorld = buildSectionTree(journals);
  const paths: { params: { world: string; section: string; journal: string }; props: PageProps }[] = [];

  for (const [journalUuid, journalPosts] of postsByJournalUuid) {
    const journal = journalByUuid.get(journalUuid)!;
    const sorted = sortPostsForJournal(journalPosts, journal.postOrder);

    const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
    for (let pageNum = 1; pageNum <= totalPages; pageNum++) {
      const pagePosts = sorted.slice((pageNum - 1) * PAGE_SIZE, pageNum * PAGE_SIZE);
      paths.push({
        params: {
          world: journal.world,
          section: journalsSegment,
          journal: pageNum === 1 ? journal.journalSlug : `${journal.journalSlug}/${pageNum}`,
        },
        props: { kind: "journal", journal, pagePosts, pageNum, totalPages },
      });
    }
  }

  for (const [world, sections] of sectionsByWorld) {
    for (const [prefixSlug, info] of sections) {
      if (journalSlugs.has(prefixSlug)) continue;
      const slugParts = prefixSlug.split("/");
      const ancestorCrumbs: Crumb[] = slugParts.slice(0, -1).map((_, i) => {
        const slug = slugParts.slice(0, i + 1).join("/");
        return { label: sections.get(slug)?.label ?? slug, href: sectionRoute(world, slug) };
      });
      const childSections: SectionInfo[] = Array.from(info.childSlugs).map((slug) => ({
        world,
        slug,
        label: sections.get(slug)?.label ?? slug.split("/").pop()!,
      }));
      const journalEntries = journalsInSubtree(sections, prefixSlug);
      
      paths.push({
        params: { world, section: journalsSegment, journal: prefixSlug },
        props: { kind: "section", label: info.label, ancestorCrumbs, childSections, journalEntries },
      });
    }
  }
  return paths;
}

const props = Astro.props as PageProps;
const siteName = getSiteConfig().siteName;

// --- Evaluation Logic Block for the "journal" kind branch ---
const journalCrumbs = props.kind === "journal" ? rootCrumbs(props.journal) : [];
const journalBase = props.kind === "journal" ? journalRoute(props.journal) : "";
const prevUrl = props.kind === "journal" && props.pageNum > 1 ? props.pageNum === 2 ? journalBase : `${journalBase}${props.pageNum - 1}/` : null;
const nextUrl = props.kind === "journal" && props.pageNum < props.totalPages ? `${journalBase}${props.pageNum + 1}/` : null;

// --- Mapping Data Sets for the "journal" display branch ---
const postItems = props.kind === "journal" ? props.pagePosts.map((post) => ({
  title: post.data.title,
  href: postRoute(post.data),
  // Per-post author -- each post in this journal's own list can have a
  // different one (Post Settings' override), so this can't be hoisted to
  // a single line above the list the way it used to be. See lib/sections.ts's
  // JournalInfo doc comment for why that journal-level line was removed.
  authorName: post.data.author.name,
  authorHref: authorRoute(post.data),
  authorImage: post.data.author.image,
  dateLabel: formatDate(post.data.publishedAt),
  frontImage: post.data.frontImage
})) : [];

// --- Mapping Data Sets for the "section" display branch ---
const sectionItems = props.kind === "section" ? props.childSections.map((s) => ({
  title: s.label,
  href: sectionRoute(s.world, s.slug),
  metaType: "section" as const
})) : [];

const sortedJournalEntries = props.kind === "section" ? [...props.journalEntries].sort((a, b) => 
  a.journal.journalTitle.localeCompare(b.journal.journalTitle)
) : [];

const journalEntriesItems = props.kind === "section" ? sortedJournalEntries.map(({ journal, subPath }) => ({
  title: journal.journalTitle,
  href: journalRoute(journal),
  subLabels: subPath
})) : [];
---

{ props.kind === "journal" ? (
  <Layout title={props.journal.journalTitle}>
    <Breadcrumbs 
      siteName={siteName} 
      crumbs={journalCrumbs} 
      currentLabel={props.journal.journalTitle} 
  />  
    <h1>{props.journal.journalTitle}</h1>

    {/* No journal-level author line here -- a journal's posts can each have their
        own author (Post Settings' override), so there's no single reliable
        author to attribute the journal itself to. See each post's own byline
        in the list below instead. */}

    {/* Handled using ContentPanel — panel title is hidden/empty since h1 acts as the header */}
    <ContentPanel title="" items={postItems} />

   {props.totalPages > 1 && (
  <Pagination 
    prevUrl={prevUrl} 
    nextUrl={nextUrl} 
    pageNum={props.pageNum} 
    totalPages={props.totalPages} 
  />
)}
  </Layout>
) : (
  <Layout title={props.label}>
        <Breadcrumbs 
      siteName={siteName} 
      crumbs={journalCrumbs} 
      currentLabel={props.label} 
/>    
    
    <h1>{props.label}</h1>
    
    {/* Collapsed layout panels */}
    <ContentPanel title="Sections" items={sectionItems} />
    <ContentPanel title="Journals" items={journalEntriesItems} />

    {props.childSections.length === 0 && props.journalEntries.length === 0 && (
      <p class="empty-state">Nothing here yet.</p>
    )}
  </Layout>
) }

<style>
  /* Local adjustments keeping the visual architecture balanced */
  h1 {
    margin-top: 1rem;
    /* Was 0.5rem plus a separate .meta rule's 3rem when a journal-level
       author line sat between the title and the post list -- carries that
       same total gap alone now that the line is gone. */
    margin-bottom: 3rem;
  }
  /* Hides the duplicate header border when ContentPanel is used directly under an H1 */
  :global(h1 + .panel > .panel-title) {
    display: none;
  }
</style>
